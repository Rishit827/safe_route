APP_NAME=SafeRoute API
ENVIRONMENT=development
# Local development:
DATABASE_URL=sqlite:///./saferoute.db
# PostgreSQL deployment example (replace credentials/host):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname?sslmode=require
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Replace with a long random secret before deployment
JWT_SECRET=change-this-secret-before-deployment
JWT_EXPIRE_MINUTES=720
USE_MOCK_DATA=true
COLLECTION_INTERVAL_MINUTES=10
REGION_BBOX=72.7,30.5,76.0,32.5
REGION_GRID_SIZE=3
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
FIRMS_MAP_KEY=
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
OPENMETEO_RAIN_THRESHOLD_MM=25
HAZARD_GROUP_DISTANCE_M=1500
ROUTE_PENALTY_WEIGHT=0.35
REQUEST_TIMEOUT_SECONDS=12
# Optional bcrypt hash for admin password; if set, it overrides ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
